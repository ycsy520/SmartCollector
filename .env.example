# 环境变量样例 —— 复制为 .env 填入真值；`.env` 已被 .gitignore 排除，切勿提交。
# ⚠️ 临时开发用途：API Key 放本地 .env，仅你机器可见。生产分发前须迁回系统 keyring
#    （AGENTS §3 数据边界：密钥不落库、不落明文日志、不回传前端；keyring 属 P8 装配）。

# DeepSeek（OpenAI 兼容 chat）。base_url/model 走 DB 配置，这里只放密钥。
DEEPSEEK_API_KEY=

# Qwen / 阿里云百炼 DashScope（text-embedding-v3 向量）。与 DeepSeek 各补其所缺：
# DeepSeek 负责 chat、Qwen 负责 embedding。key 到百炼控制台开通后获取（下称步骤）。
QWEN_API_KEY=

# 跨设备/真机调试时 Tauri CLI 使用：
# TAURI_DEV_HOST=192.168.1.100
